    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "katex": "0.16.47",
    "markdown-it": "14.3.3",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.4.299",
