#!/usr/bin/env node
import { existsSync, readFileSync, readdirSync, mkdtempSync, writeFileSync, rmSync, statfsSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { spawnSync } from "node:child_process";
import { agentDir, leerConfig, loadProject, piDir, vaultDir, webConfigPath, pythonDelVenv, PYTHON_TEXTO, WINDOWS } from "./lib/pi-sdk.mjs";

const sinRed = process.argv.includes("--sin-red");
if (process.argv.some(arg => arg === "--help" || arg === "--ayuda")) {
  console.log("Uso: .pi/scripts/doctor [--sin-red]\nVerifica instalación, ingesta, cursos y guardado local de imágenes. Por defecto hace dos pings breves a modelos y prueba búsqueda y lectura web.\n--sin-red omite esas llamadas y las marca como NO verificadas. No lee el portapapeles.");
  process.exit(0);
}
let fallos = 0;
function check(ok, label, detail) {
  if (!ok) fallos++;
  console.log(`${ok ? "✓" : "✗"} ${label}: ${detail}`);
}
// En Windows pi y npm son .cmd: spawnSync sólo los encuentra a través de la shell (sus argumentos acá son fijos y sin espacios).
function run(program, args = []) {
  const shell = WINDOWS && ["pi", "npm"].includes(program);
  const result = shell ? spawnSync([program, ...args].join(" "), { encoding: "utf8", timeout: 15000, cwd: vaultDir, shell: true, windowsHide: true })
    : spawnSync(program, args, { encoding: "utf8", timeout: 15000, cwd: vaultDir, windowsHide: true });
  return { ok: result.status === 0, text: (result.stdout || "").trim() };
}
function json(file) { return JSON.parse(readFileSync(file, "utf8")); }
const base = json(join(piDir, "curso.config.json")), config = leerConfig(piDir);
const version = run("pi", ["--version"]);
if (version.ok && version.text !== "1.4.0") console.log(`! pi: ${version.text}, distinta de la fijada 1.4.0; verificá APIs antes de usar (SETUP.md).`);
else check(version.ok, "pi", `${version.text || "no encontrado"}; se requiere 1.4.0 (ver SETUP.md)`);
// Como con pi: otra versión que cumple el piso de pi 1.4.0 (>=22.19.0) es un aviso, no una falla.
const [mayor, menor] = process.versions.node.split(".").map(Number);
if (process.version !== "v26.1.0" && (mayor > 22 || (mayor === 22 && menor >= 19))) console.log(`! Node.js: ${process.version}, distinta de la verificada v26.1.0; pi 1.4.0 pide >=22.19.0.`);
else check(process.version === "v26.1.0", "Node.js", `${process.version}; versión verificada: v26.1.0`);
if (WINDOWS) {
  // pi-learn (fish + tmux) es el lanzador de Linux; en Windows se abre con la app o con pi -ns --skill .pi/skills.
  console.log("· fish, tmux y el lanzador pi-learn: no aplican en Windows (se abre con la app).");
  const bash = [process.env.ProgramFiles, process.env["ProgramFiles(x86)"]].filter(Boolean).map(d => join(d, "Git/bin/bash.exe")).find(existsSync);
  check(Boolean(bash) || run("bash", ["--version"]).ok, "Git Bash", bash ? `${bash}; pi lo usa para la herramienta bash y los comandos de las skills` : "instalá Git for Windows: pi lo necesita para la herramienta bash");
} else {
  const fish = run("fish", ["--version"]);
  check(fish.ok && fish.text === "fish, version 4.9.3", "fish", `${fish.text || "ausente"}; versión verificada: 4.9.3`);
  const tmux = run("tmux", ["-V"]);
  check(tmux.ok && tmux.text === "tmux 3.8", "tmux instalado", tmux.ok ? tmux.text : "instalá tmux 3.8");
  check(Boolean(process.env.TMUX) && run("tmux", ["display-message", "-p", "#{pane_id}"]).ok,
    "Dentro de tmux", process.env.TMUX ? "sesión detectada" : "abrí pi con pi-learn desde fish");
  const fishFile = join(homedir(), ".config/fish/functions/pi-learn.fish");
  check(existsSync(fishFile) && readFileSync(fishFile, "utf8") === readFileSync(join(piDir, "config/fish/pi-learn.fish"), "utf8"),
    "Lanzador fish", "~/.config/fish/functions/pi-learn.fish; reinstalación en SETUP.md");
  const wayland = process.env.XDG_SESSION_TYPE === "wayland" || Boolean(process.env.WAYLAND_DISPLAY);
  const clipboard = wayland ? "wl-paste" : "xclip";
  check(run(clipboard, [wayland ? "--version" : "-version"]).ok,
    "Portapapeles", `${wayland ? "Wayland" : "X11"}: se necesita ${clipboard}; prueba Ctrl+V manual en SETUP.md`);
}
const vault = config.vault.replace(/^~(?=[\\/]|$)/, homedir());
check(resolve(vault) === vaultDir && ["_entrada", "cursos"].every(name => existsSync(join(vault, name))),
  "Rutas del vault", `${vault}; creá _entrada/ y cursos/ si faltan`);
// Un ENOSPC en clase corta el turno y deja el JSONL de la sesión con una línea partida.
const libre = Math.min(...[vaultDir, agentDir].filter(existsSync).map(dir => { const s = statfsSync(dir); return s.bavail * s.bsize; }));
const queOcupa = WINDOWS ? "Configuración > Sistema > Almacenamiento" : "du -xh -d 2 ~ | sort -h | tail";
check(libre >= 2 ** 31, "Espacio libre", `${(libre / 2 ** 30).toFixed(1).replace(".", ",")} GB en el disco del vault y de pi${libre < 2 ** 31 ? `; liberá al menos 2 GB (para ver qué ocupa: ${queOcupa})` : ""}`);
let obsidian = false;
try { obsidian = json(join(vault, ".obsidian/app.json")).userIgnoreFilters?.includes("_procesado") === true; } catch {}
check(obsidian, "Obsidian", obsidian ? "_procesado excluido" : "con Obsidian cerrado, agregá _procesado a userIgnoreFilters");
const head = run("git", ["-C", join(piDir, "git/github.com/amosblomqvist/pi-interactive-subagents"), "rev-parse", "HEAD"]);
check(head.text === "c3e8b53c0754ae5ccc19fdab5a7481ec039bc2f7", "Subagentes fijados", "3.7.2 / c3e8b53; reinstalá con el comando de SETUP.md si difiere");
let webVersion;
try { webVersion = json(join(piDir, "npm/node_modules/pi-web-access/package.json")).version; } catch {}
check(webVersion === "0.42.0", "Extensión web fijada", `${webVersion || "ausente"}; ejecutá npm ci --ignore-scripts --prefix .pi/npm`);
const webConfig = webConfigPath();
check(existsSync(webConfig) && readFileSync(webConfig, "utf8") === readFileSync(join(piDir, "config/web-search.json"), "utf8"),
  "Configuración web", `${webConfig}; instalación reproducible en SETUP.md (sin cookies; uso actual sin claves de búsqueda)`);
// El researcher es un pi -p propio: el vigilante lo corta (en Node, igual en Linux y Windows), pi-web-access le da la web y el renombre deja pasar web_fetch por --tools.
check(existsSync(join(piDir, "scripts/vigilante.mjs")), "Vigilante del researcher", "scripts/vigilante.mjs corta al hijo al vencer el plazo; si falta, el researcher no corre");
check(existsSync(join(piDir, "npm/node_modules/pi-web-access/dist/index.js")), "Web del researcher",
  ".pi/npm/node_modules/pi-web-access/dist/index.js; si falta, el researcher investiga sin web: ejecutá npm ci --ignore-scripts --prefix .pi/npm");
let fetchContent;
try { fetchContent = json(webConfig).toolNames?.fetchContent; } catch {}
check(fetchContent === "web_fetch", "web_fetch del researcher",
  `${webConfig}: toolNames.fetchContent = ${JSON.stringify(fetchContent ?? null)}; debe ser "web_fetch" o el researcher queda sin leer páginas (copiá .pi/config/web-search.json, SETUP.md)`);
const researcher = readFileSync(join(piDir, "agents/researcher.md"), "utf8");
check(researcher.match(/^model: (.+?)\r?$/m)?.[1] === base.modelo_researcher, "Modelo del researcher", "agents/researcher.md debe coincidir con curso.config.json"
  + (config.modelo_researcher !== base.modelo_researcher ? `; en esta máquina se usa ${config.modelo_researcher} (curso.config.local.json)` : ""));
check(run("git", ["-C", piDir, "diff", "--exit-code", "7cfd8942f82ab9476e63572387e1fe9bcea5082c", "--", "skills/teach/SKILL.md"]).ok,
  "teach original", "skills/teach/SKILL.md sin cambios");
// visualize dibuja con mermaid-cli (dependencia de visual-tools) y un Chrome, Chromium o Edge del sistema; sin eso los
// diagramas no se dibujan, pero el resto anda: es un aviso.
{
  const { findChrome } = await import(new URL("../extensions/visual-tools/tools/_common.ts", import.meta.url).href);
  const mmdc = existsSync(join(piDir, "extensions/visual-tools/node_modules/@mermaid-js/mermaid-cli/src/cli.js")), navegador = findChrome();
  if (mmdc && navegador) check(true, "Diagramas (visualize)", `mermaid-cli y ${navegador}`);
  else console.log(`! Diagramas (visualize): ${!mmdc ? "faltan las dependencias de visual-tools: PUPPETEER_SKIP_DOWNLOAD=1 npm ci --omit=dev --ignore-scripts --prefix .pi/extensions/visual-tools" : "no se encontró Chrome, Chromium ni Edge (o fijá PI_VISUAL_CHROME)"}`);
}
let project;
try {
  project = await loadProject();
  const { session } = project;
  const tools = new Set(session.getActiveToolNames());
  check(project.errors.length === 0 && !(project.loader.getExtensions().warnings?.length),
    "Carga de extensiones / alias", project.errors.length ? "hay errores; abrí pi --verbose" : "API instalada compatible, sin errores de carga");
  for (const name of ["quiz", "ask_user_question", "subagent", "web_search", "web_fetch", "transcribir_paginas", "guardar_items", "guardar_curso", "leer_paginas", "ver_pagina", "buscar_material", "leer_items", "investigar_tema", "leer_sesion_anterior", "registrar_progreso"]) {
    check(tools.has(name), `Herramienta ${name}`, tools.has(name) ? "cargada y activa" : "revisá la confianza del proyecto y SETUP.md");
  }
  const commands = new Set(session.extensionRunner.getRegisteredCommands().map(c => c.name));
  for (const name of ["curso-nuevo", "curso-agregar", "curso-check", "curso-estado", "estudiar", "cursos", "fin", "progreso"]) {
    check(commands.has(name), `Comando /${name}`, commands.has(name) ? "registrado" : "ejecutá /reload y revisá extensions/curso/");
  }
  const pruebaFotos = mkdtempSync(join(tmpdir(), "pi-learn-fotos-"));
  try {
    if (!commands.has("md-log") || !commands.has("md-unlog")) throw new Error("Falta md-log.");
    const file = join(pruebaFotos, "sesion.md"), png = readFileSync(join(piDir, "tests/fixtures/rojo.png"));
    const foto = join(pruebaFotos, "pi-clipboard-11111111-2222-4333-8444-555555555555.png");
    writeFileSync(file, ""); writeFileSync(foto, png);
    await session.prompt(`/md-log ${file}`);
    await session.extensionRunner.emit({ type: "message_end", message: { role: "user", timestamp: Date.now(), content: [{ type: "text", text: foto }, { type: "image", mimeType: "image/png", data: png.toString("base64") }] } });
    const texto = readFileSync(file, "utf8"), enlaces = [...texto.matchAll(/!\[\[(adjuntos\/[a-z0-9.-]+\.png)\]\]/g)].map(m => m[1]);
    check(enlaces.length === 2 && enlaces.every(e => readFileSync(join(pruebaFotos, e)).equals(png)) && !texto.includes(foto), "Fotos en md-log", "ruta de pegado nativo y bloque image copiados/embebidos sin modelo; render Obsidian requiere prueba aparte");
  } catch { check(false, "Fotos en md-log", "falló el guardado/embed local; ejecutá tests/md-log-fotos.test.mjs"); }
  finally { if (commands.has("md-unlog")) await session.prompt("/md-unlog"); rmSync(pruebaFotos, { recursive: true, force: true }); }
  check(existsSync(join(piDir, "modo-curso.md")) && existsSync(join(piDir, "scripts/ingesta/sesion.py")), "Contexto de sesión", "modo-curso y lector/render local presentes; no requiere dependencias nuevas");
  const { systemPromptOptions: prompt } = await session.extensionRunner.emitBeforeAgentStart({ messageType: "user", prompt: "" }, { cwd: vaultDir });
  const ajenas = Object.keys(prompt.sections).filter(s => !["teach", "modo_curso", "curso", "clase", "simulacro", "python"].includes(s));
  if (prompt.forceSystemPrompt !== undefined) ajenas.push("prompt completo reemplazado");
  check(!ajenas.length, "Prompt del tutor", ajenas.length ? `secciones ajenas: ${ajenas.join(", ")}; filtrá su paquete en .pi/settings.json (SETUP.md)` : "sin secciones ajenas");
  // loadProject usa las mismas opciones de skills que config/fish/pi-learn.fish.
  const skills = project.loader.getSkills(), colisiones = skills.diagnostics.filter(d => d.type === "collision").map(d => d.collision?.name);
  check(!colisiones.length && ["teach", "curso-nuevo", "curso-agregar"].every(n => skills.skills.some(s => s.name === n)), "Skills de cursos",
    colisiones.length ? `nombres repetidos: ${colisiones.join(", ")}; renombrá una en .pi/skills` : "teach, curso-nuevo y curso-agregar, sin colisiones; /reload tras cambios");
  const oculto = session.settingsManager.getHideThinkingBlock();
  check(oculto, "Thinking oculto", oculto ? "hideThinkingBlock activo" : "agregá \"hideThinkingBlock\": true a .pi/settings.json");
  const registry = session.modelRuntime, principal = config.modelo_principal || `${session.settingsManager.getDefaultProvider()}/${session.settingsManager.getDefaultModel()}`;
  // DA58: sin credenciales para el modelo configurado, pi abre la conversación con el primero que las tenga, y la visión
  // (si acepta imágenes), el researcher y los subagentes usan ése. Sólo falla si no hay ninguno.
  const conversacion = session.model && registry.hasConfiguredAuth(session.model.provider) ? session.model : undefined, usados = {};
  for (const [rol, id] of [["principal", principal], ["researcher", config.modelo_researcher], ["visión", config.modelo_vision]]) {
    const slash = id.indexOf("/"), model = registry.getModel(id.slice(0, slash), id.slice(slash + 1)), auth = Boolean(model) && registry.hasConfiguredAuth(model.provider);
    const reemplazo = !auth && conversacion && (rol !== "visión" || conversacion.input.includes("image")) ? conversacion : undefined;
    usados[rol] = auth ? model : reemplazo;
    if (reemplazo) console.log(`! Credenciales ${rol}: ${id}: ${model ? "sin credenciales" : "no está en el catálogo"}; se usa ${reemplazo.provider}/${reemplazo.id}, que sí tiene`);
    else check(auth, `Credenciales ${rol}`, `${id}: ${!model ? "no está en el catálogo; revisá /model" : auth ? "configuradas (sin llamar al modelo)" : "sin credenciales; ejecutá /login en pi"}`);
  }
  for (const [rol, configurado] of [["researcher", config.modelo_researcher], ["visión", config.modelo_vision]]) {
    const model = usados[rol], id = model ? `${model.provider}/${model.id}` : configurado;
    if (sinRed) { check(false, `Modelo ${rol}`, `${id}: sin verificar (--sin-red)`); continue; }
    if (!model) { check(false, `Modelo ${rol}`, `${id}: ningún modelo con credenciales${rol === "visión" ? " acepta imágenes" : ""}; ejecutá /login en pi`); continue; }
    try {
      const content = [{ type: "text", text: "Respondé únicamente OK." }];
      if (rol === "visión") content.push({ type: "image", mimeType: "image/png", data: readFileSync(join(piDir, "tests/fixtures/rojo.png")).toString("base64") });
      const result = await registry.completeSimple(model, {
        messages: [{ role: "user", content, timestamp: Date.now() }],
      }, { maxTokens: 64, reasoning: "off", signal: AbortSignal.timeout(30000) });
      const ok = result.stopReason === "stop" && result.content.some(block => block.type === "text" && block.text.trim());
      check(ok, `Modelo ${rol}`, ok ? `${id}: respondió${rol === "visión" ? " con imagen" : ""}` : `${id}: el proveedor rechazó o no completó el ping; revisá /login y el acceso REAL al modelo`);
    } catch { check(false, `Modelo ${rol}`, `${id}: falló el ping; revisá /login o la conexión`); }
  }
  for (const [name, args] of [["web_search", { query: "regla de la cadena derivada universidad", numResults: 2 }], ["web_fetch", { url: "https://es.wikipedia.org/wiki/Regla_de_la_cadena" }]]) {
    if (sinRed) { check(false, `Prueba ${name}`, "sin verificar (--sin-red)"); continue; }
    try {
      const runner = session.extensionRunner;
      const signal = AbortSignal.timeout(45000);
      const result = await runner.getToolDefinition(name).execute(`doctor-${name}`, args, signal, undefined, runner.createToolContext(`doctor-${name}`, signal));
      const data = result.structuredContent;
      const ok = !result.isError && (name === "web_search"
        ? data?.queries?.some(q => !q.error && q.results?.length > 0)
        : data?.urls?.some(u => !u.error && u.content?.length > 0));
      check(ok, `Prueba ${name}`, ok ? "respuesta real recibida" : "sin resultados válidos; verificá red/proveedor en SETUP.md");
    } catch { check(false, `Prueba ${name}`, "falló; revisá conexión y proveedor web en SETUP.md"); }
  }
} catch {
  check(false, "Carga de pi", "falló el SDK o una extensión; ejecutá pi --verbose (SETUP.md)");
} finally { if (project) await project.close(); }
const pythonIngesta = pythonDelVenv(piDir);
const recetaVenv = "recrealo desde el vault: UV_PROJECT_ENVIRONMENT=$PWD/.pi/.venv uv sync --project .pi/scripts/ingesta --python 3.13.13 --python-preference only-managed --locked";
if (!existsSync(pythonIngesta)) {
  check(false, "Entorno de ingesta", `falta .pi/.venv; ${recetaVenv}`);
} else {
  const ingesta = run(pythonIngesta, [join(piDir, "scripts/ingesta/comprobar.py")]);
  try {
    if (!ingesta.ok) throw new Error("diagnóstico fallido");
    for (const entrada of JSON.parse(ingesta.text).chequeos) check(entrada.ok, entrada.nombre, entrada.detalle);
  } catch { check(false, "Entorno de ingesta", `no se pudo verificar (${PYTHON_TEXTO} .pi/scripts/ingesta/comprobar.py); si el venv está roto, ${recetaVenv}`); }
}
const cursos = readdirSync(join(vaultDir, "cursos"), { withFileTypes: true }).filter(entry => entry.isDirectory());
if (!cursos.length) check(true, "Validación de cursos", "sin cursos todavía; /curso-nuevo prepara uno desde _entrada/");
for (const curso of cursos) {
  const validacion = run(pythonIngesta, [join(piDir, "scripts/ingesta/cursos.py"), "validar", "--vault", vaultDir, "--curso", curso.name]);
  try {
    const r = JSON.parse(validacion.text);
    check(r.ok === true, `Curso ${curso.name}`, r.ok ? `${r.documentos} documentos, ${r.temas} temas: estructura válida` : r.errores.join("; "));
    if (r.avisos.length) console.log(`! Preparación ${curso.name}: ${r.avisos.length} avisos; ${r.pendientes.length} páginas referidas pendientes. Revisá cursos/${curso.name}/informe-ingesta.md; no se certifica calidad por aprobar la estructura.`);
  } catch { check(false, `Curso ${curso.name}`, "no se pudo validar; ejecutá /curso-check y revisá SETUP.md"); }
}
console.log(`\n${fallos ? `Diagnóstico con ${fallos} comprobaciones fallidas o pendientes.` : "Diagnóstico automático correcto."} La sesión teach y Ctrl+V requieren además la prueba manual de SETUP.md.`);
process.exitCode = fallos ? 1 : 0;
