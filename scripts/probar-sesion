#!/usr/bin/env node
// Prueba opcional con modelo real. Se detiene en la primera pregunta, sin responder por el usuario.
import assert from "node:assert/strict";
import { appendFileSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { createHash } from "node:crypto";
import { agentDir, importPi, piDir, vaultDir } from "./lib/pi-sdk.mjs";

if (process.argv.length > 2) throw new Error("Uso: node .pi/scripts/probar-sesion (Redes, retardos; consume LLM)");
const sdk = await importPi();
const salida = join(vaultDir, "_procesado/fase4", `prueba-${Date.now()}`);
mkdirSync(salida, { recursive: true });
const settings = sdk.SettingsManager.create(vaultDir, agentDir, { projectTrusted: true });
const progreso = join(vaultDir, "cursos/redes/progreso.yaml");
const hash = file => createHash("sha256").update(readFileSync(file)).digest("hex");
const antes = hash(progreso);
let pregunta, inicio, recibido;
const primera = new Promise(resolve => { recibido = resolve; });
function crearLoader() { return new sdk.DefaultResourceLoader({ cwd: vaultDir, agentDir, settingsManager: settings,
  extensionFactories: [pi => {
    pi.on("before_agent_start", event => {
      event.systemPromptOptions.sections.ensayo_fase4 = "Ensayo técnico exclusivo de Fase 4: se omite investigar_tema y no se lanzan hijos. Continuá directamente con el probe; el researcher anclado se prueba con probar-researcher-curso.";
    });
    pi.on("tool_call", (event, ctx) => {
      if (event.toolName !== "quiz" && event.toolName !== "ask_user_question") return;
      pregunta = { herramienta: event.toolName, pregunta: event.input.question, opciones: event.input.options?.map(o => o.label), ms: performance.now() - inicio };
      recibido();
      ctx.abort();
      return { block: true, reason: "Prueba técnica detenida en la primera pregunta; no hubo respuesta del estudiante." };
    });
  }],
}); }
const manager = sdk.SessionManager.create(vaultDir, salida);
let session;
const errores = [];
async function abrir(m) {
  const loader = crearLoader();
  await loader.reload();
  assert.deepEqual(loader.getExtensions().errors, []);
  settings.applyOverrides({ compaction: { enabled: false, keepRecentTokens: 0, reserveTokens: 16384 }, retry: { enabled: false } });
  const p = await sdk.createAgentSession({ cwd: vaultDir, agentDir, settingsManager: settings, resourceLoader: loader, sessionManager: m });
  await p.session.bindExtensions({ onError: e => errores.push(e) });
  return p.session;
}
let timer;
try {
  session = await abrir(manager);
  assert.equal(`${session.model.provider}/${session.model.id}`, "openai-codex/gpt-6.1-sol");
  session.setThinkingLevel("off");
  session.setActiveToolsByName(["leer_paginas", "buscar_material", "leer_items", "ver_pagina", "quiz", "ask_user_question"]);
  inicio = performance.now();
  const arranque = session.prompt("/estudiar redes retardos");
  await Promise.race([primera, new Promise((_, reject) => { timer = setTimeout(() => reject(new Error("No llegó la primera pregunta en 120 segundos.")), 120000); })]);
  clearTimeout(timer);
  await arranque;
  await session.abort();
  assert.ok(pregunta.pregunta && pregunta.ms < 60000, "Primera pregunta fuera del objetivo de 60 s.");
  const estado = manager.getBranch().filter(e => e.type === "custom" && e.customType === "curso").at(-1).data;
  const runner = session.extensionRunner;
  const ctx = runner.createToolContext("prueba-lectura", undefined);
  const tiempos = {};
  for (const [nombre, args] of [["leer_paginas", { doc: "kurose-7", desde: 54, hasta: 55 }], ["buscar_material", { consulta: "retardo transmision" }], ["ver_pagina", { doc: "kurose-7", pagina: 54 }]]) {
    const t = performance.now();
    const r = await runner.getToolDefinition(nombre).execute("prueba-lectura", args, undefined, undefined, ctx);
    tiempos[nombre] = performance.now() - t;
    assert.ok(!r.isError);
    if (nombre === "ver_pagina") assert.ok(r.content.some(c => c.type === "image"));
    else assert.match(r.content[0].text, /#page=/);
  }
  await session.compact("Prueba técnica: conservar el tema retardos, sin simular respuestas ni progreso. El usuario todavía no respondió.");
  assert.ok(manager.getBranch().some(e => e.type === "compaction"));
  const despues = await runner.emitBeforeAgentStart({ messageType: "user", prompt: "continuación técnica" }, { cwd: vaultDir });
  assert.match(despues.systemPromptOptions.sections.curso, /retardos/);
  const file = manager.getSessionFile();
  await runner.emit({ type: "session_shutdown" }); session.dispose(); session = undefined;
  session = await abrir(sdk.SessionManager.open(file));
  const restaurado = await session.extensionRunner.emitBeforeAgentStart({ messageType: "user", prompt: "continuación técnica" }, { cwd: vaultDir });
  assert.match(restaurado.systemPromptOptions.sections.curso, /retardos/);
  assert.equal(restaurado.systemPromptOptions.sections.teach, readFileSync(join(piDir, "skills/teach/SKILL.md"), "utf8"));
  const estado2 = session.sessionManager.getBranch().filter(e => e.type === "custom" && e.customType === "curso").at(-1).data;
  assert.deepEqual(estado2, estado);
  assert.equal(hash(progreso), antes);
  assert.deepEqual(errores, []);
  const log = join(vaultDir, estado.log);
  appendFileSync(log, "\n\n> [!note] Prueba técnica Fase 4: primera pregunta emitida; sin respuesta del usuario ni progreso registrado. Compactación y reapertura comprobadas.\n");
  const evidencia = { modelo: "openai-codex/gpt-6.1-sol", primera_pregunta: pregunta, tiempos_ms: tiempos, compaction_real: true, reapertura_real: true, estado_restaurado: estado2, progreso_intacto: true,
    limite: "Smoke técnico con seis tools de lectura/preguntas, no una clase completa ni una respuesta real del alumno; no prueba fotos ni researcher anclado.", sessionFile: file };
  writeFileSync(join(salida, "resultado.json"), JSON.stringify(evidencia, null, 2) + "\n");
  console.log(JSON.stringify(evidencia, null, 2));
} catch (e) {
  console.error(`Prueba incompleta: ${e.stack || e.message}. Artefactos conservados en ${salida}`);
  process.exitCode = 1;
} finally {
  clearTimeout(timer);
  if (session) { await session.abort(); await session.extensionRunner.emit({ type: "session_shutdown" }); session.dispose(); }
}
